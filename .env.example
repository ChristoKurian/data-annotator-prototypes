# PostHog project API key (Project Settings → Project API Key in PostHog).
# This key is meant to be public/client-side — it's safe to ship in the bundle.
# Leave unset to run the prototypes with analytics fully disabled.
VITE_POSTHOG_KEY=

# Optional: only needed if your PostHog project is on the EU cloud
# (https://eu.i.posthog.com) or self-hosted. Defaults to US cloud.
VITE_POSTHOG_HOST=

# --- /report page (api/report-data.js) ---
# Server-side only — do NOT prefix with VITE_, or it would ship in the
# client bundle. A PostHog personal API key scoped to Query: Read only,
# restricted to this one project. Required for /report to return live data.
POSTHOG_API_KEY=

# Optional: override if the report should point at a different project/host
# than the one this repo is wired to by default.
POSTHOG_PROJECT_ID=
POSTHOG_HOST=
